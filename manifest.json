{
  "manifest_version": 2,
  "name": "DOM XSS Scanner",
  "version": "1.0",
  "description": "Analizza parametri URL e traccia collegamenti con sink DOM vulnerabili",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "devtools",
    "<all_urls>",
    "contextMenus",
    "notifications"
  ],

  "devtools_page": "devtools/devtools.html",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/url-analyzer.js",
        "content/sink-detector.js", 
        "content/dom-tracker.js",
        "content/content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "background": {
    "scripts": ["background/background.js"],
    "persistent": false
  },

  "web_accessible_resources": [
    "injected/page-script.js"
  ]
}